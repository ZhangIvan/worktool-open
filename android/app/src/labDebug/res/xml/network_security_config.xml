<?xml version="1.0" encoding="utf-8"?>
<!--
  lab 变体网络安全配置（W-M3R；仅 labDebug 构型生效）：
  - 仅对 lab 部署主机 192.0.2.10（自签 TLS，docs/02 §6.1 部署侧）追加信任 lab CA；
  - 不放行任何明文（cleartextTrafficPermitted 默认 false，SR-01/SR-09）；
  - 产品变体（debug/release）不受本文件影响——该文件仅存在于 labDebug 源集。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.0.2.10</domain>
        <trust-anchors>
            <certificates src="@raw/ca_lab" />
        </trust-anchors>
    </domain-config>
</network-security-config>
