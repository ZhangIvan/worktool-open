<?xml version="1.0" encoding="utf-8"?>
<!--
  lab 变体清单叠加（W-M3R 真机装配，仅 labDebug 构型）：
  - INTERNET 权限已上移产品 main 源集（CR UI-01 修复，2026-11-03：产品变体
    PairingActivity/SessionRuntime 均需联网，main 曾「零权限」导致产品配对必败）；
    本叠加层经 manifest 合并自动继承，不再重复声明；
  - networkSecurityConfig：仅对 lab 主机（构建期经 worktoolLabHost 注入，默认合成段）信任 lab CA
    （res/raw/ca_lab.crt，公钥材料；对应私钥仅存 local-private/，G13 不入库）——lab 独有，产品变体零改动；
  - LabPairingActivity：配对最小面（host + 6 位配对码 → PairingClient → V2Session hello）。
    exported=true 仅为 RIG/adb 显式启动通道（lab 装配验证），无 intent-filter。
  - LabApp（会话 21 P0）：进程入口——启动即从已存 server 地址恢复 lab 裸 IP 例外
    （EndpointPolicy 注册表为进程内易失态，配对后重装/重建进程若不恢复则主界面
    自启会话被本地拒拨，设备永不在线）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="cn.worktool.open.app.lab.LabApp"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="cn.worktool.open.app.lab.LabPairingActivity"
            android:exported="true"
            android:label="@string/lab_pairing_title" />
    </application>

</manifest>
