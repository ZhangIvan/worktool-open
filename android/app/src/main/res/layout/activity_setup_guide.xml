<?xml version="1.0" encoding="utf-8"?>
<!--
  设置引导页（BP-7/SP-3，配对前置页）：三张检测卡（无障碍 / 电池优化豁免 /
  MIUI 自启动指引）+ 完成按钮（三卡全绿才可用）。全 Android 原生组件，零外部
  UI 库；卡面样式沿用 activity_pairing 的 pair_a11y_card 形态。
  id 契约见 SetupGuideActivity：guide_a11y_* / guide_battery_* / guide_miui_* / guide_done。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_page_title"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guide_page_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 卡 a：无障碍服务（5s 轮询 enabled_accessibility_services → 绿勾） -->
        <LinearLayout
            android:id="@+id/guide_a11y_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/guide_a11y_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="⚠️" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_card_a11y_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/guide_a11y_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_card_a11y_off"
                    android:textColor="@color/status_offline"
                    android:textSize="12sp" />

                <!-- U7 不再询问（docs/16）：只影响启动路由强制，不影响卡内检测与主界面警示 -->
                <CheckBox
                    android:id="@+id/guide_a11y_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_skip_checkbox"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/guide_a11y_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_card_a11y_action" />
        </LinearLayout>

        <!-- 卡 b：电池优化豁免（PowerManager.isIgnoringBatteryOptimizations 检测） -->
        <LinearLayout
            android:id="@+id/guide_battery_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/guide_battery_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="⚠️" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_card_battery_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/guide_battery_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_card_battery_desc"
                    android:textColor="@color/status_offline"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/guide_battery_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_skip_checkbox"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/guide_battery_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_card_battery_action" />
        </LinearLayout>

        <!-- 卡 c：MIUI 自启动指引（系统无检测 API → 指引文案 + 用户手动确认） -->
        <LinearLayout
            android:id="@+id/guide_miui_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/guide_miui_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="ℹ️" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_card_miui_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/guide_miui_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_card_miui_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/guide_miui_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/guide_skip_checkbox"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/guide_miui_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guide_card_miui_confirm" />
        </LinearLayout>

        <!-- 三卡全绿才可用（SetupGuideCards.allGreen） -->
        <Button
            android:id="@+id/guide_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="@string/guide_done" />
    </LinearLayout>
</ScrollView>
