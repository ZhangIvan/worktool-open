<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置（T2.4：能力最小化放开，SR-10 / G10 manifest+config diff 审查项）。
  放开项逐条依据（docs/02 §3 core:accessibility 职责 = 5 原子操作 + 规则引擎）：
  - canRetrieveWindowContent=true：节点树读取（规则引擎选择器 / 调试页 dump 前提）
  - canPerformGestures=true：click/longClick 的手势回退（节点 ACTION 不可用时的第二通道）
  - canTakeScreenshot=true：screenshot 原子操作（属性 API 31+ 生效；低版本运行时降级）
  - accessibilityFlags=flagReportViewIds：resourceId 选择器前提（无此 flag 框架不填充资源名）
  - accessibilityEventTypes 仅 typeWindowStateChanged|typeWindowContentChanged：事件骨架最小集
  - 不设 packageNames：调试页需 dump 任意前台应用校准规则（docs/03 T2.4 D1 定位用）；
    生产订阅面收敛在 T3.1 按指令落地时复评
  - accessibilityFlags=flagRetrieveInteractiveWindows（FR-57 补开，G10 diff 审查项）：
    interactiveRoots()（WorkToolAccessibilityService）依赖 getWindows()；无此 flag 框架返回
    null，权限弹窗/对话框独立窗口层无法观测（2026-11-03 会话 2 观测面修复的同一能力位，
    代码侧已引用但本配置此前漏配——此处对齐）。仅放宽窗口读取，不含焦点/按键能力。
  未放开：flagRequestFilterKeyEvents / canRequestTouchExplorationMode 等本阶段不需要的能力。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows" />
