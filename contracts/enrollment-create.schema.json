{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deviceLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "message.send_text",
          "file.export"
        ]
      }
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    }
  },
  "required": [
    "deviceLabel",
    "capabilities",
    "expiresInSeconds"
  ]
}
