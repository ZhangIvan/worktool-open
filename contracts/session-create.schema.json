{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
    }
  },
  "required": [
    "deviceId",
    "keyId"
  ]
}
