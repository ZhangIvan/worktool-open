{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "retryable",
        "details"
      ]
    }
  },
  "required": [
    "error"
  ]
}
